# Copy to .env and adjust. .env is git-ignored.

PORT=8080
NODE_ENV=development
# Use a long random string in production:
JWT_SECRET=dev-only-change-me

# ---- Oracle (local Docker XE; defaults match docker-compose.yml) ----
DB_USER=pyaar
DB_PASSWORD=pyaar_pw
DB_CONNECT_STRING=localhost:1521/XEPDB1
ORACLE_SYS_PASSWORD=pyaar_sys_pw

# Pool sizing
DB_POOL_MIN=1
DB_POOL_MAX=6

# ---- Production / Oracle Cloud (Hostinger deploy) ----
# When using Oracle Cloud Autonomous DB with a wallet, set:
#   DB_CONNECT_STRING=<tns_alias_from_tnsnames.ora>   (e.g. pyaardb_high)
#   ORACLE_WALLET_DIR=/home/youruser/wallet
# node-oracledb Thin mode reads the wallet via these; no Instant Client needed.
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=
